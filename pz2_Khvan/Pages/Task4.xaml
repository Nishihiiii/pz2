<Page x:Class="pz2_Khvan.Pages.Task4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pz2_Khvan.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Задание 4">

    <Grid>
		<StackPanel>
			<TextBlock Text="Задача 4 (Перестановка в массиве)" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
			<TextBlock Text="Дан массив размера N. Определить количество его промежутков монотонности и переставить местами первый и последний из них." 
                       TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20"/>

			<TextBlock Text="Введите массив чисел через пробел:" FontSize="14" Margin="0,0,0,5"/>
			<TextBox x:Name="txtArrayInput" Width="400" Height="25" HorizontalAlignment="Left" Margin="0,0,0,15"/>

			<Button x:Name="btnCalculate" Content="Выполнить" Width="150" Height="30" 
                    HorizontalAlignment="Left" Click="btnCalculate_Click" Margin="0,0,0,15"/>

			<TextBlock Text="Результат:" FontSize="14" Margin="0,0,0,5"/>
			<TextBox x:Name="txtResult" Width="400" Height="80" HorizontalAlignment="Left" 
                     IsReadOnly="True" Background="#FFEAEAEA" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
		</StackPanel>
	</Grid>
</Page>
