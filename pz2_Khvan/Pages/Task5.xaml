<Page x:Class="pz2_Khvan.Pages.Task5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pz2_Khvan.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Задние 5">

    <Grid>
		<StackPanel>
			<TextBlock Text="Задача 5 (Двумерный массив)" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
			<TextBlock Text="Сгенерировать массив MxN. Вывести, найти мин/макс, отсортировать по возрастанию и убыванию." 
                       TextWrapping="Wrap" FontSize="14" Margin="0,0,0,15"/>

			<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
				<TextBlock Text="Строк (N): " VerticalAlignment="Center"/>
				<TextBox x:Name="txtRows" Width="50" Margin="0,0,15,0"/>
				<TextBlock Text="Столбцов (M): " VerticalAlignment="Center"/>
				<TextBox x:Name="txtCols" Width="50"/>
			</StackPanel>

			<Button x:Name="btnGenerate" Content="Сгенерировать и рассчитать" Width="200" Height="30" 
                    HorizontalAlignment="Left" Click="btnGenerate_Click" Margin="0,0,0,15"/>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Margin="0,0,10,0">
					<TextBlock Text="Исходный массив:" FontWeight="Bold"/>
					<TextBox x:Name="txtOriginal" FontFamily="Consolas" Height="150" IsReadOnly="True" Background="#FFEAEAEA" VerticalScrollBarVisibility="Auto"/>
					<TextBlock x:Name="tbMinMax" Margin="0,5,0,0" Foreground="Blue"/>
				</StackPanel>

				<StackPanel Grid.Column="1" Margin="0,0,10,0">
					<TextBlock Text="По возрастанию:" FontWeight="Bold"/>
					<TextBox x:Name="txtAscending" FontFamily="Consolas" Height="150" IsReadOnly="True" Background="#FFEAEAEA" VerticalScrollBarVisibility="Auto"/>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock Text="По убыванию:" FontWeight="Bold"/>
					<TextBox x:Name="txtDescending" FontFamily="Consolas" Height="150" IsReadOnly="True" Background="#FFEAEAEA" VerticalScrollBarVisibility="Auto"/>
				</StackPanel>
			</Grid>
		</StackPanel>
	</Grid>
</Page>
