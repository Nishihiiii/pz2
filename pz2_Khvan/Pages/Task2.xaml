<Page x:Class="pz2_Khvan.Pages.Task2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pz2_Khvan.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Задание 2">

    <Grid>
		<StackPanel>
			<TextBlock Text="Задача 2 (Работа со строками)" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
			<TextBlock Text="Дана строка, содержащая несколько круглых скобок. Если скобки расставлены правильно вывести 0. В противном случае вывести номер позиции первой ошибочной закрывающей скобки, или, если закрывающих не хватает, число –1." 
                       TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20"/>

			<TextBlock Text="Введите строку со скобками:" FontSize="14" Margin="0,0,0,5"/>
			<TextBox x:Name="txtStringInput" Width="300" Height="25" HorizontalAlignment="Left" Margin="0,0,0,15"/>

			<Button x:Name="btnCalculate" Content="Выполнить проверку" Width="150" Height="30" 
                    HorizontalAlignment="Left" Click="btnCalculate_Click" Margin="0,0,0,15"/>

			<TextBlock Text="Результат:" FontSize="14" Margin="0,0,0,5"/>

			<TextBox x:Name="txtResult" Width="300" Height="25" HorizontalAlignment="Left" 
                     IsReadOnly="True" Background="#FFEAEAEA"/>
		</StackPanel>
	</Grid>
</Page>
