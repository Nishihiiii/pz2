<Page x:Class="pz2_Khvan.Pages.Task1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pz2_Khvan.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Задача 1">

    <Grid>
		<StackPanel>
			<TextBlock Text="Задача 1 (Работа с числами)" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
			<TextBlock Text="Дан номер некоторого года (положительное целое число). Вывести соответствующий ему номер столетия, учитывая, что, к примеру, началом 20 столетия был 1901 год." 
                       TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20"/>

			<TextBlock Text="Введите номер года:" FontSize="14" Margin="0,0,0,5"/>
			<TextBox x:Name="txtYearInput" Width="200" Height="25" HorizontalAlignment="Left" Margin="0,0,0,15"/>

			<Button x:Name="btnCalculate" Content="Выполнить расчет" Width="150" Height="30" 
                    HorizontalAlignment="Left" Click="btnCalculate_Click" Margin="0,0,0,15"/>

			<TextBlock Text="Результат:" FontSize="14" Margin="0,0,0,5"/>
		
			<TextBox x:Name="txtResult" Width="300" Height="25" HorizontalAlignment="Left" 
                     IsReadOnly="True" Background="#FFEAEAEA"/>
		</StackPanel>
	</Grid>
</Page>
